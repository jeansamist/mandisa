# Matches compose.yaml at the repo root.
DATABASE_URL=postgres://mandisa:mandisa@localhost:5433/mandisa
PORT=4000
# debug also logs every SQL query; use info in production.
LOG_LEVEL=debug

# Shared with web/.env.local: only the web server may call the API.
INTERNAL_API_KEY=change-me-to-a-long-random-string
WEB_URL=http://localhost:3000

# ElgioPay mobile money (sandbox). Mobile money is hidden until a key is set.
ELGIOPAY_BASE_URL=https://sandbox-api.elgiopay.com
ELGIOPAY_API_KEY=
ELGIOPAY_WEBHOOK_SECRET=

# WhatsApp notifications ("log" until a provider is chosen).
NOTIFICATIONS_PROVIDER=log
ADMIN_WHATSAPP=+237650911804

# AI assistant on the site (Claude API). Leave empty to turn the assistant off.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (Console > Workspaces > ID).
ANTHROPIC_WORKSPACE_ID=

# Google Gemini (Gemini models in /ms/assistant). Leave empty if unused.
GEMINI_API_KEY=
